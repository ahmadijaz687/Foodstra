# FoodStra — API environment. Copy to apps/api/.env for local dev.
# NEVER commit real secrets. All values below are placeholders.

NODE_ENV=development
PORT=4000

# MySQL primary store
DATABASE_URL="mysql://foodstra:foodstra@localhost:3306/foodstra"

# Redis (cache / session / rate-limit)
REDIS_URL="redis://localhost:6379"

# Auth — generate long random values in real environments
JWT_ACCESS_SECRET="replace-with-32+char-random-string"
JWT_REFRESH_SECRET="replace-with-different-32+char-random-string"
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# Stripe (test mode). Supplied via env only — never inline in code.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# Observability
SENTRY_DSN=

CORS_ORIGINS=*

# --- Mobile (apps/mobile) ---
# EXPO_PUBLIC_API_URL=http://localhost:4000
#
# EAS / Expo auth is provided ONLY via environment, never written to a repo file:
#   export EXPO_TOKEN=<injected from your secrets manager / shell>
