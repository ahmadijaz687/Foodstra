{
  "name": "foodstra",
  "version": "0.1.0",
  "private": true,
  "description": "FoodStra — consumer food delivery platform (customer app, vendor dashboard, driver app, backend).",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "build": "pnpm --filter @foodstra/shared build && pnpm -r --filter \"!@foodstra/shared\" build",
    "typecheck": "pnpm --filter @foodstra/shared build && pnpm -r typecheck",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm --filter @foodstra/shared build && pnpm -r test",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@types/node": "20.14.15",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "eslint": "8.57.0",
    "eslint-config-prettier": "9.1.0",
    "husky": "9.1.4",
    "prettier": "3.3.3",
    "typescript": "5.5.4"
  }
}
